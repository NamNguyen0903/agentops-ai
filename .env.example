APP_ENV=development
APP_DEBUG=false

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL — illustrative local values
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=change_me_locally
