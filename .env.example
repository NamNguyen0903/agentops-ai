# Research execution — initial hypotheses
MAX_MODEL_CALLS=8
MAX_SEARCH_CALLS=6
MAX_RETRIEVAL_CALLS=12
MAX_RESEARCH_TOKENS=40000
MAX_RESEARCH_COST_USD=1.00
